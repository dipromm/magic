  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Player">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/GameEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Reveal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa el efecto de hacer que el objetivo muestre públicamente todas las cartas de una zona especificada (por ejemplo, su mano). No altera el juego más allá de la información revelada.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/COUNTER">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa la acción de anular una carta de hechizo en la pila, evitando que su efecto se resuelva. El objetivo debe ser una carta de tipo hechizo (instantáneo o conjuro) y el resultado es que la carta es puesta en el cementerio sin resolverse.</rdfs:comment>
  </rdf:Description>
