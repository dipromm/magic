    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Counters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Hexproof">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Tap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Ability"/>
    <rdfs:comment xml:lang="es">Coste de activación que requiere girar (tapar) la permanente que posee la habilidad. Es una acción que cambia el estado de la carta a girada y se paga como parte del coste para activar la habilidad.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Put_onto_battlefield_tapped">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa la acción de colocar una carta desde una zona (por ejemplo, la biblioteca) al campo de batalla en estado girado (tapped).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Effect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Planeswalker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Power">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Ending_phase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/PhaseandStep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/manaCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.tfg.mtg.simulacion/ontology/Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Add_counter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Cuando la habilidad desencadenada "Al comienzo de tu fase de mantenimiento" se resuelve, el controlador de Aether Vial puede colocar un contador de carga (Charge) sobre Aether Vial. Según la regla 704.5g, colocar un contador implica añadir un objeto Counter al permanente, actualizar su lista de contadores y reflejar el nuevo número de contadores en cualquier efecto que dependa de él. No se paga coste de maná ni se requiere ninguna condición adicional más allá de la decisión del jugador.</rdfs:comment>
    <rdfs:label>charge counter</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Indestructible">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Untap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Beggining_phase"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Discard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa el efecto de obligar a un objetivo a mover una carta de su zona de mano al cementerio. Se aplica a un objetivo especificado y no depende de otras condiciones de juego.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/CardAtribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
