    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
    <rdfs:comment xml:lang="es">Indica que una carta no es del tipo tierra. Se emplea como valor en comparaciones contra CardType para excluir cartas de tipo tierra.</rdfs:comment>
  </rdf:Description>
