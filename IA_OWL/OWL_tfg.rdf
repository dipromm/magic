    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Counters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/KeywordAbility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/PhaseandStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Stun">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Counters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Manapool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/GameEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/ConvertedManaCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
    <rdfs:comment xml:lang="es">Representa el coste de maná convertido de una carta, es decir, el valor numérico total de maná que se necesita para lanzar la carta, sin importar los colores. Se utiliza para comparaciones y efectos que hacen referencia al coste de maná total.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Destroy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/motivoCuarentena">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.tfg.mtg.simulacion/ontology/Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/CardType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
    <rdfs:comment xml:lang="es">Representa el tipo de una carta (por ejemplo, criatura, tierra, instantáneo, etc.). Se utiliza en comparaciones para determinar si una carta cumple con una restricción de tipo.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Instant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Toughness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/PlusOne_PlusOne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Counters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Combat_damage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Combat_phase"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/hasCardSupertype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.tfg.mtg.simulacion/ontology/Card"/>
    <rdfs:range rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardSupertype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Draw">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Beggining_phase"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Protection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Enter_the_battlefield">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Trigger_event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Trigger_event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Lifelink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Exile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Zones"/>
    <rdfs:comment xml:lang="es">Representa la acción de mover una carta del juego a la zona de Exilio, removiéndola del campo de batalla y de otras zonas accesibles al jugador.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Triggered_ability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Ability"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Haste">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/DoubleStrike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/FirstStrike">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_creature_card_hand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
    <rdfs:comment xml:lang="es">Representa un objetivo que es una carta de criatura en la zona de la mano del jugador. Se utiliza cuando una habilidad permite seleccionar o mover una carta de criatura desde la mano a otra zona, como el campo de batalla.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Battlefield">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Zones"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_spell">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Combat_phase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/PhaseandStep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Shuffle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa la acción de mezclar aleatoriamente la biblioteca del jugador, alterando el orden de las cartas que contiene.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Counters">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Color">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Lose_life">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa el efecto de reducir la vida del jugador o permanente objetivo en una cantidad especificada. El valor numérico se indica en los parámetros del efecto.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Land">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/ManaCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAtribute"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Cleanup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Ending_phase"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Stack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Zones"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Vigilance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Oil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Counters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Menace">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Ability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/flagRevisionHumana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://www.tfg.mtg.simulacion/ontology/Card"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/CardSupertype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Artifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Reveal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa el efecto de hacer que el objetivo muestre públicamente todas las cartas de una zona especificada (por ejemplo, su mano). No altera el juego más allá de la información revelada.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Zones">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Graveyard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Zones"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_card_library">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
    <rdfs:comment xml:lang="es">Representa una carta elegida del mazo del jugador objetivo. Se usa como objetivo para efectos que buscan o manipulan cartas en la zona Library.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Card">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_self_player">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Reach">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/KeywordAbility"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_permanent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Search_library">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Representa la acción de buscar una carta que cumpla ciertos criterios dentro de la biblioteca del jugador, sin revelar la biblioteca completa.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Dies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Trigger_event"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/CardSubtype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Target_card_hand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/TargetType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/TargetType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/GameEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
