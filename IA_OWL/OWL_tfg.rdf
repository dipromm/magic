  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/AddSubtype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/Effect"/>
    <rdfs:comment xml:lang="es">Adds a specified subtype to target permanents. The effect takes a target and adds the given subtype (e.g., Forest) to the permanent's existing subtypes while preserving other types.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/TotalPower">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.tfg.mtg.simulacion/ontology/CardAttribute"/>
    <rdfs:comment xml:lang="es">Suma del poder actual de los objetos que describe query en la misma comparación. Se evalúa en el momento de resolver el efecto.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.tfg.mtg.simulacion/ontology/Status">
